<!-- SHOPIFY VTO WIDGET -->
<!-- Paste this code in a "Custom Liquid" block in your Theme Customizer, near the Add to Cart button -->

<style>
  .vto-btn {
    width: 100%;
    background-color: #000;
    color: #fff;
    padding: 12px;
    border-radius: 4px;
    font-weight: bold;
    text-align: center;
    cursor: pointer;
    margin-top: 10px;
    transition: background 0.3s;
    border: none;
    font-size: 16px;
  }
  .vto-btn:hover {
    background-color: #333;
  }
  
  /* Modal Styles */
  #vto-modal {
    display: none;
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.8);
    z-index: 999999;
    align-items: center;
    justify-content: center;
  }
  #vto-modal-content {
    background: #fff;
    padding: 24px;
    border-radius: 8px;
    max-width: 400px;
    width: 90%;
    text-align: center;
    position: relative;
  }
  #vto-close {
    position: absolute;
    top: 10px;
    right: 15px;
    font-size: 24px;
    cursor: pointer;
    background: none;
    border: none;
  }
  #vto-result-img {
    max-width: 100%;
    border-radius: 4px;
    margin-top: 15px;
    display: none;
  }
  #vto-loader {
    display: none;
    margin: 20px 0;
    font-size: 16px;
    color: #666;
  }
  .vto-spinner {
    border: 4px solid #f3f3f3;
    border-top: 4px solid #000;
    border-radius: 50%;
    width: 30px;
    height: 30px;
    animation: vto-spin 1s linear infinite;
    margin: 0 auto 10px auto;
  }
  @keyframes vto-spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
</style>

<button class="vto-btn" id="vto-trigger">? Try it on virtually</button>
<input type="file" id="vto-file-input" accept="image/*" style="display: none;" />

<div id="vto-modal">
  <div id="vto-modal-content">
    <button id="vto-close">&times;</button>
    <h3 id="vto-title" style="margin-top:0;">Virtual Try-On</h3>
    
    <div id="vto-loader">
      <div class="vto-spinner"></div>
      <p>Generating your try-on...<br/><small>This usually takes 5-10 seconds.</small></p>
    </div>
    
    <img id="vto-result-img" alt="Virtual Try On Result" />
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const triggerBtn = document.getElementById('vto-trigger');
  const fileInput = document.getElementById('vto-file-input');
  const modal = document.getElementById('vto-modal');
  const closeModal = document.getElementById('vto-close');
  const loader = document.getElementById('vto-loader');
  const resultImg = document.getElementById('vto-result-img');
  const title = document.getElementById('vto-title');

  // Grab product images safely using Liquid
  const productImages = {{ product.images | json }};
  
  // Format URLs (Shopify sometimes returns relative URLs or without protocol)
  const fullImageUrls = productImages.map(img => {
    if (img.startsWith('//')) return 'https:' + img;
    return img;
  });

  triggerBtn.addEventListener('click', (e) => {
    e.preventDefault();
    fileInput.click();
  });

  closeModal.addEventListener('click', () => {
    modal.style.display = 'none';
  });

  fileInput.addEventListener('change', async (e) => {
    const file = e.target.files[0];
    if (!file) return;

    // Reset UI
    resultImg.style.display = 'none';
    resultImg.src = '';
    loader.style.display = 'block';
    title.innerText = 'Working magic...';
    modal.style.display = 'flex';

    try {
      // 1. Convert user image to Base64
      const base64 = await new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });

      // 2. Send to backend
      // IMPORTANT: Replace the URL with your actual deployed Node.js backend domain
      const API_URL = 'http://localhost:3001/api/shopify/vto'; 

      const response = await fetch(API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          customerImageBase64: base64,
          productImageUrls: fullImageUrls
        })
      });

      const data = await response.json();
      
      if (!response.ok) {
        throw new Error(data.error || 'Failed to generate');
      }

      // 3. Show result
      loader.style.display = 'none';
      title.innerText = 'Your Virtual Try-On';
      resultImg.src = data.image;
      resultImg.style.display = 'block';

    } catch (err) {
      alert('Error: ' + err.message);
      modal.style.display = 'none';
    }
    
    // Clear input so user can try again
    fileInput.value = '';
  });
});
</script>
